# systemd user service for the WasteWise web app.
# Install: mkdir -p ~/.config/systemd/user && cp deploy/*.service ~/.config/systemd/user/
#          systemctl --user daemon-reload && systemctl --user enable --now wastewise-app wastewise-api
#          sudo loginctl enable-linger $USER     # keep running after logout
[Unit]
Description=WasteWise web app (Streamlit)
After=network-online.target

[Service]
WorkingDirectory=%h/wastewise
Environment=WW_HOST=127.0.0.1
ExecStart=%h/wastewise/.venv/bin/python -m streamlit run app/main.py --server.address ${WW_HOST} --server.port 8501
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
